DEFINE SCHEMA

RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

RECORD TYPE CD_AppSettings (
    CD_aiSummaryEnabled INT64,
    CD_aiSummaryModelRawValue STRING,
    CD_aiSummaryModelRawValue_ckAsset ASSET,
    CD_boardAutoplayDurationMinutes INT64,
    CD_boardAutoplayEnabled INT64,
    CD_boardAutoplayEndHour INT64,
    CD_boardAutoplayEndMinute INT64,
    CD_boardAutoplaySkipChinaHolidays INT64,
