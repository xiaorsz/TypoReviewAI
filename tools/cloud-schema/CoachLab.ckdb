    CD_boardManualPlaybackOptionRawValue STRING,
    CD_boardManualPlaybackOptionRawValue_ckAsset ASSET,
    CD_childName STRING,
    CD_childName_ckAsset ASSET,
    CD_dailyLimit INT64,
    CD_entityName STRING,
    CD_id STRING,
    CD_moveReceipt BYTES,
    CD_remindHour INT64,
    CD_remindMinute INT64,
    CD_reviewInteractionStyleRawValue STRING,
    CD_reviewInteractionStyleRawValue_ckAsset ASSET,
    "___createTime" TIMESTAMP,
    "___createdBy" REFERENCE,
    "___etag" STRING,
    "___modTime" TIMESTAMP,
    "___modifiedBy" REFERENCE,
    "___recordID" REFERENCE QUERYABLE
);

